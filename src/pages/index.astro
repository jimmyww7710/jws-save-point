---
import { Image } from 'astro:assets';
import CategoryList from '../components/CategoryList.astro';
import PostGrid from '../components/PostGrid.astro';
import TagList from '../components/TagList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import { CATEGORY_GROUPS, type CategoryGroup } from '../config/taxonomy';
import { collectCategories, collectTags, getPublishedPosts, groupOf, groupUrl } from '../utils/posts';
import hero from '../assets/hero.webp';

const posts = await getPublishedPosts();
const latest = posts.slice(0, 6);
const tags = collectTags(posts).slice(0, 16);
const groups = (Object.keys(CATEGORY_GROUPS) as CategoryGroup[]).map((key) => ({
  key,
  ...CATEGORY_GROUPS[key],
  count: posts.filter((p) => groupOf(p) === key).length,
  categories: collectCategories(posts, key),
}));
---

<BaseLayout>
  <section class="hero">
    <Image
      class="hero-bg"
      src={hero}
      alt=""
      widths={[800, 1280, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="wrap hero-inner">
      <p class="eyebrow">Code / Life / Thinking</p>
      <h1>每一次記錄，<br />都是一個存檔點</h1>
      <p class="intro">{SITE.description}</p>
      <div class="actions">
        <a class="btn" href="/blog/">閱讀文章 <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/about/">關於我</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest">
    <div class="wrap">
      <div class="section-head">
        <h2 id="latest">最新文章</h2>
        <a class="text-link" href="/blog/">查看全部 →</a>
      </div>
      <PostGrid posts={latest} />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="topics">
    <div class="wrap">
      <div class="section-head">
        <h2 id="topics">探索主題</h2>
        <a class="text-link" href="/categories/">所有分類 →</a>
      </div>
      <div class="groups">
        {
          groups.map((group) => (
            <article class="group">
              <p class="eyebrow">{group.key === 'tech' ? 'Tech Notes' : 'Life Notes'}</p>
              <h3>
                <a href={groupUrl(group.key)}>
                  {group.label} <span class="count">{group.count} 篇</span>
                </a>
              </h3>
              <p>{group.description}</p>
              <CategoryList items={group.categories} label={`${group.label}分類`} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  {
    tags.length > 0 && (
      <section class="section" aria-labelledby="tags">
        <div class="wrap">
          <div class="section-head">
            <h2 id="tags">熱門標籤</h2>
            <a class="text-link" href="/tags/">所有標籤 →</a>
          </div>
          <TagList tags={tags} label="熱門標籤" />
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: 400px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background: #17445e;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(8, 40, 62, 0.86), rgba(8, 40, 62, 0.35));
  }
  .hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-top: 68px;
    padding-bottom: 68px;
  }
  .hero .eyebrow {
    opacity: 0.92;
  }
  .hero h1 {
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    line-height: 1.25;
    letter-spacing: 0.04em;
    margin: 0 0 18px;
  }
  .intro {
    max-width: 520px;
    margin: 0 0 26px;
    color: #eef5f9;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .group {
    background: var(--paper);
    border: 1px solid #dce5eb;
    border-radius: var(--radius);
    padding: 28px;
  }
  .group .eyebrow {
    color: var(--link);
    margin-bottom: 4px;
  }
  .group h3 {
    font-size: 1.3rem;
    margin: 0 0 6px;
  }
  .group h3 a:hover {
    color: var(--link);
  }
  .group .count {
    font-size: 0.85rem;
    font-weight: 400;
    color: var(--faint);
    margin-left: 6px;
  }
  .group > p:not(.eyebrow) {
    color: var(--muted);
    font-size: 0.92rem;
    margin: 0 0 18px;
  }

  @media (max-width: 760px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero {
      min-height: 380px;
    }
    .hero-inner {
      padding-top: 52px;
      padding-bottom: 52px;
    }
    .hero h1 {
      font-size: 1.95rem;
    }
    .intro {
      font-size: 0.95rem;
    }
    .group {
      padding: 22px;
    }
  }
</style>
