---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';
import { getPublishedPosts, type Post } from '../../utils/posts';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, seo, cover, coverAlt, publishedAt, category, tags } = post.data;
---

<BaseLayout title={seo?.title ?? title} description={seo?.description ?? description}>
  <article>
    <h1>{title}</h1>
    <p>
      <time datetime={formatDate(publishedAt)}>{formatDate(publishedAt)}</time> · {category} · {tags.join(', ')}
    </p>
    {cover && <Image src={cover} alt={coverAlt ?? ''} widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 760px" />}
    <Content />
  </article>
</BaseLayout>
