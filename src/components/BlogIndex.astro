---
// /blog/ 與 /blog/page/N/ 共用的文章列表內容。
import ListingLayout from '../layouts/ListingLayout.astro';
import CategoryList from './CategoryList.astro';
import Pagination from './Pagination.astro';
import PostGrid from './PostGrid.astro';
import TagList from './TagList.astro';
import { collectCategories, collectTags, type Post } from '../utils/posts';

interface Props {
  allPosts: Post[];
  posts: Post[];
  page: number;
  totalPages: number;
}

const { allPosts, posts, page, totalPages } = Astro.props;
const categories = collectCategories(allPosts).filter((c) => c.count > 0);
const tags = collectTags(allPosts).slice(0, 12);
---

<ListingLayout
  eyebrow="Articles"
  title={page === 1 ? '所有文章' : `所有文章・第 ${page} 頁`}
  description={`共 ${allPosts.length} 篇文章，依發布日期由新到舊排列。可依分類或標籤篩選。`}
>
  <section class="filters" aria-label="篩選文章">
    <div class="filter-row">
      <h2>分類</h2>
      <CategoryList items={categories} label="依分類篩選" />
    </div>
    {
      tags.length > 0 && (
        <div class="filter-row">
          <h2>熱門標籤</h2>
          <TagList tags={tags} label="依標籤篩選" />
          <a class="text-link" href="/tags/">所有標籤 →</a>
        </div>
      )
    }
  </section>

  <PostGrid posts={posts} eagerCount={page === 1 ? 3 : 0} />
  <Pagination current={page} total={totalPages} />
</ListingLayout>

<style>
  .filters {
    display: grid;
    gap: 14px;
    margin-bottom: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  h2 {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
    min-width: 5em;
  }
</style>
