---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import defaultOgImage from '../assets/hero.webp';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  article?: { publishedAt: Date; updatedAt?: Date; category: string; tags: string[] };
  noindex?: boolean;
}

const { title, description = SITE.description, image, imageAlt, article, noindex = false } = Astro.props;
const pageTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const og = await getImage({ src: image ?? defaultOgImage, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogImage = new URL(og.src, Astro.site).href;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#172b40" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedAt.toISOString()} />
          {article.updatedAt && <meta property="article:modified_time" content={article.updatedAt.toISOString()} />}
          <meta property="article:author" content={SITE.author} />
          <meta property="article:section" content={article.category} />
          {article.tags.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
  </head>
  <body id="top">
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
