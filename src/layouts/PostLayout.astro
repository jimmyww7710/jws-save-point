---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import PostGrid from '../components/PostGrid.astro';
import TagList from '../components/TagList.astro';
import Toc from '../components/Toc.astro';
import { CATEGORY_GROUPS, getCategory } from '../config/taxonomy';
import { formatDate } from '../utils/date';
import { categoryUrl, groupUrl, postUrl, toTagLinks, type Post } from '../utils/posts';

interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
  related: Post[];
}

const { post, headings, newer, older, related } = Astro.props;
const { title, description, seo, cover, coverAlt, publishedAt, updatedAt, category, tags, draft } = post.data;
const categoryInfo = getCategory(category);
const published = formatDate(publishedAt);
const updated = updatedAt && formatDate(updatedAt);
---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? description}
  image={cover}
  imageAlt={coverAlt}
  article={{ publishedAt, updatedAt, category, tags }}
>
  <article class="post">
    <header class="post-head wrap">
      <nav class="crumbs" aria-label="麵包屑">
        <a href={groupUrl(categoryInfo.group)}>{CATEGORY_GROUPS[categoryInfo.group].label}</a>
        <span aria-hidden="true">/</span>
        <a href={categoryUrl(categoryInfo)}>{category}</a>
      </nav>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <p class="meta">
        <span>發布於 <time datetime={published}>{published}</time></span>
        {updated && updated !== published && <span>更新於 <time datetime={updated}>{updated}</time></span>}
        {draft && <span class="draft">草稿（僅本機預覽）</span>}
      </p>
      <TagList tags={toTagLinks(tags)} />
    </header>

    {
      cover && (
        <div class="cover wrap">
          <Image
            src={cover}
            alt={coverAlt ?? ''}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 800px) 100vw, 1020px"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }

    <div class="post-main wrap">
      <div class="post-content">
        <div class="toc-inline"><Toc headings={headings} variant="inline" /></div>
        <div class="post-body">
          <div class="prose" data-prose>
            <slot />
          </div>
        </div>
      </div>
      <aside class="toc-aside"><Toc headings={headings} variant="sidebar" /></aside>
    </div>

    <footer class="post-foot wrap">
      {
        (newer || older) && (
          <nav class="adjacent" aria-label="上一篇與下一篇">
            {older ? (
              <a class="adjacent-link" href={postUrl(older)} rel="prev">
                <span class="label">← 上一篇</span>
                <span class="title">{older.data.title}</span>
              </a>
            ) : (
              <span />
            )}
            {newer && (
              <a class="adjacent-link next" href={postUrl(newer)} rel="next">
                <span class="label">下一篇 →</span>
                <span class="title">{newer.data.title}</span>
              </a>
            )}
          </nav>
        )
      }
    </footer>
  </article>

  {
    related.length > 0 && (
      <section class="section section--tint" aria-labelledby="related">
        <div class="wrap">
          <div class="section-head">
            <h2 id="related">相關文章</h2>
            <a class="text-link" href={categoryUrl(categoryInfo)}>
              更多 {category} →
            </a>
          </div>
          <PostGrid posts={related} />
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // 程式碼區塊：加上語言標籤與複製按鈕（需要 JavaScript，因此由腳本產生，不會留下無作用的按鈕）。
  for (const pre of document.querySelectorAll<HTMLPreElement>('[data-prose] pre')) {
    const wrapper = document.createElement('div');
    wrapper.className = 'code-block';
    const bar = document.createElement('div');
    bar.className = 'code-bar';
    const lang = document.createElement('span');
    lang.textContent = pre.dataset.language ?? '';
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-btn';
    button.textContent = '複製';
    button.setAttribute('aria-label', '複製程式碼');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/\n$/, ''));
        button.textContent = '已複製';
      } catch {
        button.textContent = '複製失敗';
      }
      window.setTimeout(() => (button.textContent = '複製'), 2000);
    });
    bar.append(lang, button);
    pre.replaceWith(wrapper);
    wrapper.append(bar, pre);
  }

  // 側欄目錄：標示目前閱讀的段落。
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
    );
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter((el): el is HTMLElement => !!el);
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        links.get(visible.target.id)?.setAttribute('aria-current', 'true');
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    targets.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .post {
    padding-bottom: 56px;
  }
  .post-head,
  .post-foot {
    max-width: calc(var(--prose) + var(--gutter) * 2);
  }
  .post-head {
    padding-top: 48px;
    padding-bottom: 28px;
  }
  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 12px;
  }
  .crumbs a {
    color: var(--link);
    font-weight: 650;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.3;
    margin: 0 0 14px;
    overflow-wrap: anywhere;
  }
  .lead {
    font-size: 1.08rem;
    color: var(--muted);
    margin: 0 0 16px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    font-size: 0.88rem;
    color: var(--faint);
    margin: 0 0 16px;
  }
  .draft {
    background: #fff3cd;
    color: #7a5a00;
    padding: 0 8px;
    border-radius: 4px;
  }
  .cover {
    max-width: calc(var(--prose) + var(--gutter) * 2);
    margin-bottom: 40px;
  }
  .cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
  }

  /* 正文與側欄目錄：寬螢幕兩欄，窄螢幕改為正文上方可收合的目錄。 */
  .post-main {
    max-width: calc(var(--prose) + var(--gutter) * 2);
  }
  .toc-aside {
    display: none;
  }
  .post-body {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 40px var(--gutter);
  }
  @media (min-width: 1180px) {
    .post-main {
      max-width: calc(var(--prose) + 280px + var(--gutter) * 2);
      display: grid;
      grid-template-columns: minmax(0, var(--prose)) 240px;
      gap: 40px;
      align-items: start;
    }
    .post-head,
    .post-foot {
      max-width: calc(var(--prose) + 280px + var(--gutter) * 2);
      padding-right: calc(280px + var(--gutter));
    }
    .cover {
      max-width: calc(var(--prose) + 280px + var(--gutter) * 2);
    }
    /* 側欄撐滿整列高度，內部目錄才能 sticky 跟著捲動。 */
    .toc-aside {
      display: block;
      align-self: stretch;
      padding-top: 8px;
    }
    .toc-inline {
      display: none;
    }
  }

  .prose :global(.code-block) {
    margin: 0 0 1.3em;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  .prose :global(.code-block pre) {
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .prose :global(.code-bar) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px 4px 14px;
    background: var(--soft);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .prose :global(.copy-btn) {
    border: 1px solid var(--line);
    background: var(--paper);
    color: var(--ink);
    border-radius: 6px;
    padding: 2px 10px;
    min-height: 30px;
    font-size: 0.8rem;
    cursor: pointer;
  }
  .prose :global(.copy-btn:hover) {
    border-color: var(--link);
    color: var(--link);
  }

  .post-foot {
    margin-top: 32px;
  }
  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .adjacent-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    transition: border-color 0.2s;
  }
  .adjacent-link:hover {
    border-color: var(--link);
  }
  .adjacent-link.next {
    text-align: right;
  }
  .adjacent-link .label {
    font-size: 0.8rem;
    color: var(--faint);
  }
  .adjacent-link .title {
    font-weight: 650;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .post-head {
      padding-top: 32px;
    }
    .cover {
      padding: 0;
      margin-bottom: 24px;
    }
    .cover img {
      border-radius: 0;
    }
    .post-main {
      padding: 0;
    }
    .toc-inline {
      padding: 0 var(--gutter);
    }
    .post-body {
      border-radius: 0;
      border-left: 0;
      border-right: 0;
      padding: 28px var(--gutter);
    }
    .adjacent {
      grid-template-columns: 1fr;
    }
    .adjacent-link.next {
      text-align: left;
    }
    .prose :global(.code-block) {
      margin-left: calc(var(--gutter) * -1);
      margin-right: calc(var(--gutter) * -1);
      border-radius: 0;
      border-left: 0;
      border-right: 0;
    }
  }
</style>
